{
  "name": "medical-3d-viewer",
  "displayName": "Medical 3D Viewer",
  "description": "Local DICOM 2D image, CT series and NIfTI volume viewer with RTSTRUCT and LIDC XML overlays for VS Code (research and development use)",
  "version": "0.1.0",
  "publisher": "zetatechnology",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zetatechnology/medical-3d-viewer.git"
  },
  "homepage": "https://github.com/zetatechnology/medical-3d-viewer#readme",
  "bugs": {
    "url": "https://github.com/zetatechnology/medical-3d-viewer/issues"
  },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Visualization"],
  "activationEvents": ["onCustomEditor:dicom3d.seriesEditor"],
  "main": "./src/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "dicom3d.seriesEditor",
        "displayName": "Medical 3D Viewer",
        "selector": [
          { "filenamePattern": "*.dcm" },
          { "filenamePattern": "*.DCM" },
          { "filenamePattern": "*.dicom" },
          { "filenamePattern": "*.DICOM" },
          { "filenamePattern": "*.ima" },
          { "filenamePattern": "*.IMA" },
          { "filenamePattern": "*.nii" },
          { "filenamePattern": "*.NII" },
          { "filenamePattern": "*.nii.gz" },
          { "filenamePattern": "*.NII.GZ" }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {"fast-xml-parser":"^5.11.2"}
}
